<section data-reveal-item class="surface-float mt-10 rounded-3xl p-6 sm:p-8">
  <p class="text-sm uppercase tracking-[0.2em] text-gray-500 dark:text-gray-400">Let's connect</p>
  <h2 class="mt-1 text-lg font-semibold text-gray-900 dark:text-gray-100">Say hello</h2>
  <p class="mt-3 text-gray-600 dark:text-gray-300">
    If something here struck a chord — or you think MindCanvas is missing something
    obvious — I'd genuinely like to hear about it. Find me wherever you already are.
  </p>

  <div class="mt-5 flex flex-wrap gap-3">
    <% social_links.each do |link| %>
      <a
        href="<%= link[:href] %>"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="<%= link[:name] %>"
        class="surface-chip inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full text-gray-700 transition-[background-color,box-shadow,transform] duration-300 ease-spring hover:-translate-y-0.5 hover:rotate-6 hover:bg-gray-50 active:scale-90 dark:text-gray-200 dark:hover:bg-gray-700"
      ><%= link[:icon].html_safe %></a>
    <% end %>
  </div>
</section>
