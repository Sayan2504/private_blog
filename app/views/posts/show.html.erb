<% content_for :title, @post.title %>
<% content_for :sidebar_active, "dashboard" %>

<article class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
  <!-- Reading progress -->
  <div class="sticky top-0 z-20 -mt-12 h-0.5 bg-transparent">
    <div data-controller="progress" class="reading-progress h-full w-full rounded-full bg-gray-900 dark:bg-gray-100"></div>
  </div>

  <div class="mt-12">
    <%= render PostHeaderComponent.new(post: @post, current_user: current_user) %>
  </div>

  <!-- Article Content -->
  <div data-reveal-prose data-controller="reader" class="prose prose-lg prose-gray max-w-none break-words">
    <%= @post.content %>
  </div>

  <!-- Back Link -->
  <div data-reveal-item class="mt-4 pt-4">
    <%= render ButtonComponent.new(variant: :ghost, size: :md, href: dashboard_path, icon: '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>') do %>
      Back to all stories
    <% end %>
  </div>
</article>
