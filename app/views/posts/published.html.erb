<% content_for :title, "Published — MindCanvas" %>
<% content_for :sidebar_active, "published" %>

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-10 pt-20 lg:pb-12 lg:pt-24">
  <div data-reveal-item class="flex flex-col gap-2 pb-2 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-sm uppercase tracking-[0.2em] text-gray-500 dark:text-gray-400">Published <%= @posts.size %></p>
      <h1 class="mt-1 text-2xl font-semibold text-gray-900 dark:text-gray-100">Your published stories</h1>
    </div>
    <p class="text-sm text-gray-500 dark:text-gray-400">Only your published stories appear here.</p>
  </div>

  <% if @posts.any? %>
    <div data-reveal-stack class="mt-6 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
      <% @posts.each do |post| %>
        <%= render PostCardComponent.new(post: post, current_user: current_user) %>
      <% end %>
    </div>
  <% else %>
    <div data-reveal-item class="surface-float mt-8 rounded-3xl py-16 text-center">
      <svg class="w-12 h-12 text-gray-300 dark:text-gray-600 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/>
      </svg>
      <h3 class="text-base font-medium text-gray-900 dark:text-gray-100 mb-1">No stories yet</h3>
      <p class="text-sm text-gray-500 dark:text-gray-400 mb-6">Get started by writing your first post.</p>
      <%= render ButtonComponent.new(variant: :primary, size: :md, href: new_post_path) do %>
        Write your first story
      <% end %>
    </div>
  <% end %>
</div>
