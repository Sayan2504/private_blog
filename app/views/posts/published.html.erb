<% content_for :title, "All stories — MindCanvas" %>
<% content_for :sidebar_active, "published" %>

<%# The public archive: every published post by every author, readable
    without an account. Nothing here is filtered to the current user — that
    view lives at /posts/mine. %>

<div data-reveal-item class="flex flex-col gap-2 pb-2 sm:flex-row sm:items-end sm:justify-between">
  <div>
    <p class="text-sm uppercase tracking-[0.2em] text-gray-500 dark:text-gray-400">All stories <%= @posts.size %></p>
    <h1 class="mt-1 text-2xl font-semibold text-gray-900 dark:text-gray-100">Everything published on MindCanvas</h1>
  </div>
  <p class="text-sm text-gray-500 dark:text-gray-400">Published stories from every writer here.</p>
</div>

<% if @posts.any? %>
  <div data-reveal-stack class="mt-6 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
    <% @posts.each do |post| %>
      <%= render PostCardComponent.new(post: post, current_user: current_user) %>
    <% end %>
  </div>
<% elsif user_signed_in? %>
  <%= render EmptyStateComponent.new(
        icon: :document,
        title: "Nothing published yet",
        body: "Once a story goes live it shows up here for everyone.",
        cta_label: "Write the first story",
        cta_href: new_post_path
      ) %>
<% else %>
  <%= render EmptyStateComponent.new(
        icon: :document,
        title: "Nothing published yet",
        body: "Check back soon — published stories will appear here."
      ) %>
<% end %>
