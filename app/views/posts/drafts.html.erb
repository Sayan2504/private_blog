<% content_for :title, "Drafts — MindCanvas" %>
<% content_for :sidebar_active, "drafts" %>

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-10 pt-20 lg:pb-12 lg:pt-24">
  <div data-reveal-item class="pb-2">
    <p class="text-sm uppercase tracking-[0.2em] text-gray-500 dark:text-gray-400">Drafts <%= @posts.size %></p>
    <h1 class="mt-1 text-2xl font-semibold text-gray-900 dark:text-gray-100">Saved ideas, ready when you are</h1>
  </div>

  <% if @posts.any? %>
    <div data-reveal-stack class="mt-6 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
      <% @posts.each do |post| %>
        <%= render PostCardComponent.new(post: post, current_user: current_user) %>
      <% end %>
    </div>
  <% else %>
    <div data-reveal-item class="surface-float mt-8 rounded-3xl py-16 text-center">
      <svg class="w-12 h-12 text-gray-300 dark:text-gray-600 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
      </svg>
      <h3 class="text-base font-medium text-gray-900 dark:text-gray-100 mb-1">No drafts yet</h3>
      <p class="text-sm text-gray-500 dark:text-gray-400 mb-6">Ideas you save without publishing will show up here.</p>
      <%= render ButtonComponent.new(variant: :primary, size: :md, href: new_post_path) do %>
        Start a draft
      <% end %>
    </div>
  <% end %>
</div>
