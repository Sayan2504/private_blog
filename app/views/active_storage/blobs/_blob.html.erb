<figure class="attachment attachment--<%= blob.image? || blob.video? || blob.audio? ? 'preview' : 'file' %> attachment--<%= blob.filename.extension %>">
  <% if blob.video? %>
    <video controls playsinline preload="metadata" class="w-full rounded-2xl shadow-sm">
      <source src="<%= rails_blob_path(blob, only_path: true) %>" type="<%= blob.content_type %>">
    </video>
  <% elsif blob.audio? %>
    <audio controls preload="metadata" class="w-full">
      <source src="<%= rails_blob_path(blob, only_path: true) %>" type="<%= blob.content_type %>">
    </audio>
  <% elsif blob.image? || blob.representable? %>
    <%= image_tag blob.representation(resize_to_limit: local_assigns[:in_gallery] ? [ 800, 600 ] : [ 1024, 768 ]),
          class: "mx-auto rounded-2xl",
          alt: blob.try(:caption).presence || blob.filename.base %>
  <% else %>
    <div class="inline-flex items-center gap-2 rounded-xl border border-gray-200 bg-gray-50 px-3.5 py-2 text-sm text-gray-700 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200">
      <span class="font-medium"><%= blob.filename %></span>
      <span class="text-xs text-gray-400">(<%= number_to_human_size blob.byte_size %>)</span>
    </div>
  <% end %>

  <% if blob.image? || blob.video? || blob.audio? %>
    <figcaption class="attachment__caption">
      <% if caption = blob.try(:caption) %>
        <%= caption %>
      <% else %>
        <span class="attachment__name"><%= blob.filename %></span>
        <span class="attachment__size"><%= number_to_human_size blob.byte_size %></span>
      <% end %>
    </figcaption>
  <% end %>
</figure>
