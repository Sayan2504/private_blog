<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "MindCanvas" %></title>
    <script>
      if (localStorage.getItem('theme') === 'dark' || (!localStorage.getItem('theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      }
      // Gates the reveal animations' hidden start state, so content is never
      // stuck invisible when JavaScript is unavailable.
      document.documentElement.classList.add('js');
    </script>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%# Turbo 8 runs same-origin navigations through the View Transitions API.
        The frame (header/sidebar/footer) is identical between pages, so the
        root cross-fade only ever shows on the content, while named elements
        — post cards and the article header — morph between the two. %>
    <meta name="view-transition" content="same-origin">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Bump ?v= whenever public/icon.* changes — browsers cache favicons hard
        and will keep serving the old one from their own store otherwise. %>
    <link rel="icon" href="/icon.png?v=2" type="image/png">
    <link rel="icon" href="/icon.svg?v=2" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png?v=2">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="flex h-screen overflow-hidden bg-gray-50 dark:bg-gray-950 text-gray-900 dark:text-gray-100 antialiased transition-colors duration-200" data-controller="sidebar" data-action="turbo:visit@window->sidebar#close">
    <div data-sidebar-target="overlay" data-action="click->sidebar#close" class="fixed inset-0 z-50 hidden bg-gray-950/40 backdrop-blur-sm md:hidden"></div>

    <!-- App-shell layout: the body is exactly one viewport tall and never
         scrolls (h-screen + overflow-hidden), so the sidebar panel is a fixed
         frame. Only the content column below scrolls, which is why the sidebar
         stays put no matter how long a post is.

         Nothing here is a bordered section: the sidebar is set off from the
         page canvas by tone alone, the header is a transparent frame holding
         floating clusters, and flash messages float over the content rather
         than pushing it down. -->
    <%= render SidebarComponent.new(active: content_for(:sidebar_active)&.to_sym) %>

    <!-- min-w-0 is required: without it this flex child refuses to shrink
         below its content's min-content width, which pushes wide grids and
         long words into a horizontal scroll under the sidebar. `relative`
         anchors the two overlays below — the header and the flash stack. -->
    <div data-controller="chrome" class="relative flex min-h-0 min-w-0 flex-1 flex-col">
      <%= render HeaderComponent.new(user_signed_in: user_signed_in?) %>

      <div class="pointer-events-none absolute inset-x-0 top-14 z-30 min-[425px]:top-[4.5rem]">
        <div class="pointer-events-auto">
          <% if notice.present? %>
            <%= render FlashComponent.new(type: :notice, message: notice) %>
          <% end %>
          <% if alert.present? %>
            <%= render FlashComponent.new(type: :alert, message: alert) %>
          <% end %>
        </div>
      </div>

      <div data-scroll-root class="flex min-h-0 min-w-0 flex-1 flex-col overflow-y-auto">
        <%# Reports the moment content starts sliding under the header, so the
            clusters know when to lift. One pixel tall, so it costs the page
            layout nothing. %>
        <div data-chrome-target="sentinel" class="h-px shrink-0"></div>

        <%# [&>*]:w-full is global on purpose: a page container using
            "max-w-* mx-auto" is a flex item here, and its auto side margins
            cancel the default stretch, collapsing it to fit-content. Forcing
            width:100% on direct children keeps every page — current and
            future — at the same measure regardless of how much it contains. %>
        <main data-controller="reveal" class="flex min-h-0 min-w-0 flex-1 flex-col [&>*]:w-full">
          <%= yield %>
        </main>
      </div>
    </div>
  </body>
</html>
