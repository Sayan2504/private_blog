<% content_for :title, "Dashboard — MindCanvas" %>
<% content_for :sidebar_active, "dashboard" %>

<div data-reveal-item class="pb-2">
  <p class="text-sm uppercase tracking-[0.2em] text-gray-500 dark:text-gray-400">Overview</p>
  <h1 class="mt-1 text-2xl font-semibold text-gray-900 dark:text-gray-100">MindCanvas, at a glance</h1>
</div>

<% if @published_count.zero? && @draft_count.to_i.zero? %>
  <%# A signed-out reader can't fix an empty archive, so they get the news
      without a button that only bounces them to a sign-in screen. %>
  <% if user_signed_in? %>
    <%= render EmptyStateComponent.new(
          icon: :document,
          title: "No stories yet",
          body: "Metrics will show up here once you publish your first post.",
          cta_label: "Write your first story",
          cta_href: new_post_path
        ) %>
  <% else %>
    <%= render EmptyStateComponent.new(
          icon: :document,
          title: "No stories yet",
          body: "Nothing has been published on MindCanvas yet. Check back soon."
        ) %>
  <% end %>
<% else %>
  <%# Three tiles for a reader, four for an author. Both column counts are
      written out literally so Tailwind's scanner can see them. %>
  <div class="mt-8 grid grid-cols-2 gap-4 <%= @draft_count ? "lg:grid-cols-4" : "lg:grid-cols-3" %>">
    <div data-reveal-item class="surface-float rounded-2xl p-5">
      <p class="text-sm text-gray-500 dark:text-gray-400">Published</p>
      <p class="mt-2 text-3xl font-semibold text-gray-900 dark:text-gray-100"><%= @published_count %></p>
    </div>
    <% if @draft_count %>
      <div data-reveal-item class="surface-float rounded-2xl p-5">
        <p class="text-sm text-gray-500 dark:text-gray-400">Your drafts</p>
        <p class="mt-2 text-3xl font-semibold text-gray-900 dark:text-gray-100"><%= @draft_count %></p>
      </div>
    <% end %>
    <div data-reveal-item class="surface-float rounded-2xl p-5">
      <p class="text-sm text-gray-500 dark:text-gray-400">Total views</p>
      <p class="mt-2 text-3xl font-semibold text-gray-900 dark:text-gray-100 tabular-nums"><%= @total_views %></p>
    </div>
    <div data-reveal-item class="surface-float rounded-2xl p-5">
      <p class="text-sm text-gray-500 dark:text-gray-400">Avg. reading time</p>
      <p class="mt-2 text-3xl font-semibold text-gray-900 dark:text-gray-100"><%= @avg_reading_time %> <span class="text-lg font-medium text-gray-400 dark:text-gray-500">min</span></p>
    </div>
  </div>

  <section data-reveal-item class="surface-float mt-10 rounded-3xl p-6">
    <p class="text-sm uppercase tracking-[0.2em] text-gray-500 dark:text-gray-400">Trending</p>
    <h2 class="mt-1 text-lg font-semibold text-gray-900 dark:text-gray-100">Most-read stories</h2>

    <% if @trending_posts.any? %>
      <ol class="mt-5 divide-y divide-gray-100 dark:divide-gray-800">
        <% @trending_posts.each_with_index do |post, index| %>
          <!-- minmax(0,1fr) on the title column is what lets a long title
               truncate instead of widening the whole page. -->
          <li class="grid grid-cols-[1.25rem_minmax(0,1fr)_auto] items-center gap-4 py-3">
            <span class="text-sm font-medium text-gray-400 dark:text-gray-500 tabular-nums"><%= index + 1 %></span>
            <%= link_to post.title, post_path(post), class: "truncate text-sm font-medium text-gray-900 dark:text-gray-100 hover:underline" %>
            <span class="text-sm text-gray-500 dark:text-gray-400 tabular-nums"><%= post.views_count %> views</span>
          </li>
        <% end %>
      </ol>
    <% else %>
      <p class="mt-5 text-sm text-gray-500 dark:text-gray-400">No views yet — once readers visit published stories, the most-read ones will show up here.</p>
    <% end %>
  </section>

  <section class="mt-10">
    <div data-reveal-item class="flex flex-col gap-2 pb-2 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-sm uppercase tracking-[0.2em] text-gray-500 dark:text-gray-400">All stories <%= @posts.size %></p>
        <h2 class="mt-1 text-lg font-semibold text-gray-900 dark:text-gray-100">Everything published on MindCanvas</h2>
      </div>
    </div>

    <% if @posts.any? %>
      <div data-reveal-stack class="mt-6 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        <% @posts.each do |post| %>
          <%= render PostCardComponent.new(post: post, current_user: current_user) %>
        <% end %>
      </div>
    <% else %>
      <p class="mt-6 text-sm text-gray-500 dark:text-gray-400">No published stories yet.</p>
    <% end %>
  </section>
<% end %>
