<% content_for :title, "Choose a new password — MindCanvas" %>

<%# Step two: reached only through the mailed link, which carries the token in
    the query string and is stashed in the hidden field below. Losing that
    field breaks the whole flow, so it stays first inside the form. %>

<div class="flex min-h-full items-center justify-center">
  <div data-reveal-item data-reveal-scale class="surface-float w-full max-w-md rounded-3xl p-8">
    <div class="space-y-2 mb-8">
      <p class="text-sm uppercase tracking-[0.2em] text-gray-500 dark:text-gray-400">Account recovery</p>
      <h1 class="text-3xl font-semibold tracking-tight text-gray-900 dark:text-gray-100">Choose a new password</h1>
      <p class="text-sm text-gray-600 dark:text-gray-300">Pick something you haven't used here before. You'll be signed in as soon as it's saved.</p>
    </div>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.hidden_field :reset_password_token %>

      <div class="space-y-5">
        <div>
          <%= f.label :password, "New password", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5" %>
          <% if @minimum_password_length %>
            <p class="text-xs text-gray-500 dark:text-gray-400 mb-1.5"><%= @minimum_password_length %> characters minimum</p>
          <% end %>
          <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "w-full rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-900 px-4 py-2.5 text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:border-gray-900 dark:focus:border-gray-100 transition-colors" %>
        </div>

        <div>
          <%= f.label :password_confirmation, "Confirm new password", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-900 px-4 py-2.5 text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:border-gray-900 dark:focus:border-gray-100 transition-colors" %>
        </div>

        <div class="pt-2">
          <%= f.submit "Save new password", class: "w-full cursor-pointer rounded-lg bg-gray-900 px-4 py-2.5 font-medium text-white hover:bg-gray-700 transition-colors dark:bg-gray-100 dark:text-gray-900 dark:hover:bg-gray-300" %>
        </div>
      </div>
    <% end %>

    <div class="mt-6 pt-6">
      <p class="text-center text-sm text-gray-600 dark:text-gray-300">
        Link expired?
        <%= link_to "Request a new one", new_password_path(resource_name), class: "font-medium text-gray-900 dark:text-gray-100 hover:underline" %>
      </p>
    </div>
  </div>
</div>
