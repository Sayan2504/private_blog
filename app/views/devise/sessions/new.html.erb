<% content_for :title, "Sign in — MindCanvas" %>

<div class="flex min-h-full items-center justify-center">
  <div data-reveal-item data-reveal-frame class="surface-float w-full max-w-md rounded-3xl p-8">
    <div data-reveal-item data-reveal-wave class="space-y-2 mb-8">
      <p class="text-sm uppercase tracking-[0.2em] text-gray-500 dark:text-gray-400">Welcome back</p>
      <h1 class="text-3xl font-semibold tracking-tight text-gray-900 dark:text-gray-100">Sign in to MindCanvas</h1>
      <p class="text-sm text-gray-600 dark:text-gray-300">Access your dashboard and manage your stories.</p>
    </div>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), local: true) do |f| %>
      <div class="space-y-5">
        <div data-reveal-item data-reveal-wave>
          <%= f.label :email, class: auth_label_classes %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: auth_field_classes %>
        </div>

        <div data-reveal-item data-reveal-wave>
          <%= f.label :password, class: auth_label_classes %>
          <%= f.password_field :password, autocomplete: "current-password", class: auth_field_classes %>
        </div>

        <% if devise_mapping.rememberable? %>
          <div data-reveal-item data-reveal-wave class="flex items-center">
            <%= f.check_box :remember_me, { class: "rounded border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-100" } %>
            <%= f.label :remember_me, "Keep me signed in", class: "ml-2 text-sm text-gray-700 dark:text-gray-300" %>
          </div>
        <% end %>

        <div data-reveal-item data-reveal-wave class="pt-2">
          <%= f.submit "Sign in", class: auth_submit_classes , data: { turbo_submits_with: "Signing in…" } %>
        </div>
      </div>
    <% end %>

    <div data-reveal-item data-reveal-wave class="mt-6 pt-6 space-y-3">
      <% if devise_mapping.recoverable? %>
        <p class="text-center text-sm">
          <%= link_to "Forgot your password?", new_password_path(resource_name), class: "text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-gray-100 hover:underline" %>
        </p>
      <% end %>
      <p class="text-center text-sm text-gray-600 dark:text-gray-300">
        Don't have an account?
        <%= link_to "Sign up", new_registration_path(resource_name), class: "font-medium text-gray-900 dark:text-gray-100 hover:underline" %>
      </p>
    </div>
  </div>
</div>
