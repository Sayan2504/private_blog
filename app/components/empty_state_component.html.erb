<div data-reveal-item class="surface-float mt-8 rounded-3xl py-16 text-center">
  <svg class="w-12 h-12 text-gray-300 dark:text-gray-600 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <%= icon_path %>
  </svg>
  <h3 class="text-base font-medium text-gray-900 dark:text-gray-100 mb-1"><%= title %></h3>
  <p class="text-sm text-gray-500 dark:text-gray-400 <%= cta? ? "mb-6" : "" %>"><%= body %></p>
  <% if cta? %>
    <%= render ButtonComponent.new(variant: :primary, size: :md, href: cta_href) do %>
      <%= cta_label %>
    <% end %>
  <% end %>
</div>
