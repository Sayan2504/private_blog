<%# Lives at the bottom of the sidebar panel, as a chip floating on it — the
    app has no page-level footer band, and nothing separates this from the nav
    but space. %>
<footer class="mt-auto shrink-0 px-4 pt-3 pb-5">
  <div class="surface-chip inline-flex max-w-full items-center gap-2 rounded-full py-1.5 pl-2.5 pr-3.5">
    <svg class="w-4 h-4 shrink-0 text-gray-400 dark:text-gray-500" fill="currentColor" viewBox="0 0 24 24">
      <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
    </svg>
    <span class="truncate text-xs text-gray-500 dark:text-gray-400">Sayan Sinha &copy; <%= Date.current.year %></span>
  </div>
</footer>
