<%# The whole card is the click target, via a stretched link on the title
    rather than a wrapper around half the content.

    Two things were wrong with the wrapper. Visually, only the inner block
    responded — the padding, the footer row and the gap between elements were
    dead, on a card that lifts on hover and looks clickable everywhere. And the
    link's accessible name was everything it wrapped: a screen reader announced
    the status, the author, the date, the title *and* 160 characters of excerpt
    as one link. The title alone is the name now; the ::after covers the card. %>
<article data-reveal-item style="--vt-name: post-<%= post.id %>" class="post-morph surface-float surface-lift group relative min-w-0 rounded-3xl p-6 transition-[transform,box-shadow] duration-500 ease-soft hover:-translate-y-1">
  <div class="flex h-full flex-col gap-4">
    <div>
      <div class="flex items-center justify-between text-xs uppercase tracking-[0.18em] text-gray-500 dark:text-gray-400">
        <span><%= post.published? ? "Published" : "Draft" %></span>
        <span><%= post.reading_time %> min read</span>
      </div>

      <div class="mt-3 flex items-center space-x-2 text-sm">
        <%= render AvatarComponent.new(name: post.author, size: :sm) %>
        <span class="font-medium text-gray-700 dark:text-gray-200"><%= post.author.presence || "Anonymous" %></span>
        <span class="text-gray-300 dark:text-gray-600">&middot;</span>
        <% if post.published? %>
          <time datetime="<%= post.published_at.iso8601 %>" class="text-gray-500 dark:text-gray-400"><%= post.published_at.strftime("%b %-d, %Y") %></time>
        <% else %>
          <span class="inline-flex items-center rounded-full bg-yellow-100 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-[0.18em] text-yellow-800 dark:bg-yellow-900/80 dark:text-yellow-100">Draft</span>
        <% end %>
      </div>

      <h2 class="mt-4 text-xl font-semibold tracking-tight text-gray-900 dark:text-gray-100 transition-colors group-hover:text-gray-700 dark:group-hover:text-gray-200">
        <%# `before:absolute before:inset-0` is the stretched link: the anchor
            keeps the title as its accessible name while its own pseudo-element
            covers the card. The focus ring needs no special handling — an
            outline follows the anchor's own inline box, so it lands on the
            title text rather than around the invisible overlay. %>
        <%= link_to post.title, post_path(post), class: "before:absolute before:inset-0 before:content-['']" %>
      </h2>

      <p class="mt-3 text-sm text-gray-600 dark:text-gray-300 line-clamp-3 break-words">
        <%= post.content.to_plain_text.truncate(160) %>
      </p>
    </div>

    <%# Raised above the stretched link, or these would be unclickable. Each is
        a 32px box rather than a bare 16px icon: the icon stays the same size,
        the target around it becomes a real one for a thumb. %>
    <div class="relative z-10 mt-auto flex items-center justify-between pt-4">
      <span class="text-xs uppercase tracking-[0.18em] text-gray-400 dark:text-gray-500">
        <% if post.published? %>
          <%= pluralize(post.views_count, "view") %>
        <% else %>
          Edited <%= time_ago_in_words(post.updated_at) %> ago
        <% end %>
      </span>

      <% if owner? %>
        <div class="flex items-center gap-1">
          <%= link_to edit_post_path(post),
                aria: { label: "Edit #{post.title}" }, title: "Edit",
                class: "icon-button rounded-full text-gray-400 transition-colors hover:bg-gray-100 hover:text-gray-700 dark:text-gray-500 dark:hover:bg-gray-800 dark:hover:text-gray-300" do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
            </svg>
          <% end %>

          <%= link_to post_path(post),
                aria: { label: "Delete #{post.title}" }, title: "Delete",
                data: {
                  turbo_method: :delete,
                  turbo_confirm: "This removes the story and everything in it. It cannot be undone.",
                  turbo_confirm_title: "Delete this story?",
                  turbo_confirm_label: "Delete story",
                  turbo_confirm_variant: "danger"
                },
                class: "icon-button rounded-full text-red-400 transition-colors hover:bg-red-50 hover:text-red-600 dark:text-red-500 dark:hover:bg-red-950/60 dark:hover:text-red-400" do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
            </svg>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</article>
