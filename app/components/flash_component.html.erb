<%# Click anywhere on the toast dismisses it, and the × makes that discoverable
    and reachable from the keyboard — click-the-whole-thing is an affordance
    nobody can see and nobody can Tab to.

    The role comes from the variant: a notice is polite and never interrupts a
    screen reader mid-sentence, while an alert is assertive and, crucially,
    stays on screen until it is dismissed. %>
<div
  class="flash-toast motion-flash pointer-events-auto flex w-full max-w-xs cursor-pointer items-start gap-2.5 rounded-2xl py-3 pl-3.5 pr-2 text-sm text-gray-700 dark:text-gray-200 sm:max-w-sm"
  role="<%= role %>"
  data-controller="flash"
  data-flash-auto-dismiss-value="<%= auto_dismiss? %>"
  data-action="click->flash#dismiss"
>
  <svg class="mt-px h-4 w-4 shrink-0 <%= accent_class %>" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <%= icon_path %>
  </svg>
  <span class="min-w-0 flex-1 leading-snug"><%= message %></span>

  <button
    type="button"
    data-action="flash#dismiss"
    aria-label="Dismiss"
    class="-mt-0.5 inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-gray-400 transition-colors hover:bg-gray-100 hover:text-gray-700 dark:text-gray-500 dark:hover:bg-gray-800 dark:hover:text-gray-200"
  >
    <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
    </svg>
  </button>
</div>
