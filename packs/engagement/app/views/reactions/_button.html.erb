<%= tag.div id: dom_id(post, :reaction), class: (local_assigns[:animate] ? "motion-pop" : nil) do %>
  <% if user_signed_in? %>
    <%= button_to post_reaction_path(post),
          method: :post,
          class: "inline-flex items-center gap-1.5 rounded-full border border-gray-200 bg-white/80 px-3.5 py-1.5 text-sm font-medium text-gray-700 transition duration-200 ease-spring hover:-translate-y-0.5 hover:border-gray-300 hover:bg-gray-50 active:scale-90 dark:border-gray-700 dark:bg-gray-900/80 dark:text-gray-200",
          aria: { label: "Applaud story" } do %>
      <span aria-hidden="true">&#128079;</span>
      <span id="<%= dom_id(post, :reaction_count) %>" class="tabular-nums"><%= post.reactions_count %></span>
    <% end %>
  <% else %>
    <span class="inline-flex items-center gap-1.5 rounded-full border border-gray-200 bg-white/60 px-3.5 py-1.5 text-sm text-gray-500 dark:border-gray-700 dark:bg-gray-900/60 dark:text-gray-400">
      <span aria-hidden="true">&#128079;</span>
      <span id="<%= dom_id(post, :reaction_count) %>" class="tabular-nums"><%= post.reactions_count %></span>
    </span>
  <% end %>
<% end %>

