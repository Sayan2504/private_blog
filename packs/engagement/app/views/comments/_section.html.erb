<section id="comments" class="mt-10 border-t border-gray-200/70 pt-8 dark:border-gray-800">
  <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100">
    Discussion (<span id="comments-count"><%= post.comments.count %></span>)
  </h2>

  <% if user_signed_in? %>
    <div id="comment-form" class="mt-4">
      <%= render "comments/form", post: post, comment: Comment.new %>
    </div>
  <% else %>
    <p class="mt-3 text-sm text-gray-500 dark:text-gray-400">
      <%= link_to "Sign in", new_user_session_path, class: "font-medium text-gray-900 underline dark:text-gray-100" %> to join the discussion.
    </p>
  <% end %>

  <div id="comments-list" class="mt-6 space-y-3">
    <% post.comments.chronological.each do |comment| %>
      <%= render "comments/comment", comment: comment %>
    <% end %>
  </div>
</section>

