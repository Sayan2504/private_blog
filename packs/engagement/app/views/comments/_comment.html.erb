<%= tag.div id: dom_id(comment), class: "surface-float rounded-2xl p-4 #{'motion-item-in' if local_assigns[:animate] || local_assigns[:broadcast]}" do %>
  <div class="flex items-start justify-between gap-3">
    <div class="flex items-center gap-2.5">
      <%= render AvatarComponent.new(name: comment.user.display_name, size: :sm) %>
      <div>
        <%= link_to comment.user.display_name, author_path(comment.user), class: "text-sm font-medium text-gray-900 hover:underline dark:text-gray-100" %>
        <p class="text-xs text-gray-500 dark:text-gray-400"><%= time_ago_in_words(comment.created_at) %> ago</p>
      </div>
    </div>
    <% viewer = local_assigns[:broadcast] ? nil : current_user %>
    <% if viewer && CommentPolicy.new(viewer, comment).destroy? %>
      <%= button_to post_comment_path(comment.post, comment),
            method: :delete,
            class: "text-xs text-gray-400 transition hover:text-red-600 dark:text-gray-500 dark:hover:text-red-400" do %>
        Delete
      <% end %>
    <% end %>
  </div>
  <p class="mt-3 whitespace-pre-line text-sm text-gray-700 dark:text-gray-300"><%= comment.body %></p>
<% end %>

