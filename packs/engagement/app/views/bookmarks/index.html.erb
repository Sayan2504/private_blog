<% content_for :title, "Saved stories — MindCanvas" %>
<% content_for :sidebar_active, "bookmarks" %>

<div data-reveal-item class="flex flex-col gap-2 pb-2 sm:flex-row sm:items-end sm:justify-between">
  <div>
    <p class="text-sm uppercase tracking-[0.2em] text-gray-500 dark:text-gray-400">Reading list <%= @posts.size %></p>
    <h1 class="mt-1 text-2xl font-semibold text-gray-900 dark:text-gray-100">Saved stories</h1>
  </div>
  <p class="text-sm text-gray-500 dark:text-gray-400">Stories you bookmarked to read or revisit.</p>
</div>

<% if @posts.any? %>
  <div data-reveal-stack class="mt-6 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
    <% @posts.each do |post| %>
      <%= render PostCardComponent.new(post: post, current_user: current_user) %>
    <% end %>
  </div>
<% else %>
  <%= render EmptyStateComponent.new(
        icon: :document,
        title: "Your reading list is empty",
        body: "Bookmark any story while reading and it will appear here.",
        cta_label: "Browse stories",
        cta_href: published_posts_path
      ) %>
<% end %>

