<% content_for :title, @post.title %>
<% content_for :head do %>
  <meta property="og:type" content="article">
  <meta property="og:title" content="<%= @post.title %>">
  <meta property="og:description" content="<%= @post.content.to_plain_text.truncate(160) %>">
  <meta property="og:url" content="<%= post_url(@post) %>">
  <meta name="twitter:card" content="summary_large_image">
<% end %>
<%# Reading a story lit up Dashboard, which is neither where you came from nor
    where you are. A published post belongs to the public archive; your own
    draft belongs to My stories, which is the only place it is listed. %>
<% content_for :sidebar_active, (@post.published? ? "published" : "mine") %>

<%= turbo_stream_from @post %>

<article>
  <!-- Reading progress -->
  <div class="sticky top-0 z-20 -mt-20 h-0.5 bg-transparent lg:-mt-24">
    <div data-controller="progress" class="reading-progress h-full w-full rounded-full bg-gray-900 dark:bg-gray-100"></div>
  </div>

  <%# Placeholder and article share one grid cell, so handing over is a
      cross-fade rather than a reflow — the row is already the finished
      article's height while the skeleton is on screen. %>
  <div data-controller="skeleton" class="grid">
    <%# Mirrors the real structure below it beat for beat: two title lines at
        the h1's size, the author chip on the same surface-float row, then
        prose lines on the body's 1.8 line-height rhythm. aria-hidden because
        the real article is already in the DOM directly underneath — screen
        readers should never see the placeholder at all. %>
    <div class="skeleton-layer [grid-area:1/1]" aria-hidden="true">
      <div class="mt-20 lg:mt-24">
        <div class="mb-8">
          <div class="mb-4 space-y-6 sm:space-y-8">
            <div class="skeleton-bar h-8 w-[92%] sm:h-11"></div>
            <div class="skeleton-bar h-8 w-[64%] sm:h-11"></div>
          </div>

          <div class="surface-float flex items-center justify-between gap-4 rounded-2xl px-5 py-4">
            <div class="flex items-center space-x-3">
              <div class="skeleton-bar h-10 w-10 rounded-full"></div>
              <div class="space-y-2">
                <div class="skeleton-bar h-3.5 w-28"></div>
                <div class="skeleton-bar h-3 w-44"></div>
              </div>
            </div>
            <div class="hidden items-center gap-2 sm:flex">
              <div class="skeleton-bar h-8 w-16"></div>
              <div class="skeleton-bar h-8 w-20"></div>
            </div>
          </div>
        </div>

        <div class="space-y-5">
          <div class="space-y-4">
            <div class="skeleton-bar h-4 w-full"></div>
            <div class="skeleton-bar h-4 w-full"></div>
            <div class="skeleton-bar h-4 w-[88%]"></div>
          </div>
          <div class="space-y-4">
            <div class="skeleton-bar h-4 w-full"></div>
            <div class="skeleton-bar h-4 w-[95%]"></div>
            <div class="skeleton-bar h-4 w-full"></div>
            <div class="skeleton-bar h-4 w-[72%]"></div>
          </div>
          <div class="space-y-4">
            <div class="skeleton-bar h-4 w-[96%]"></div>
            <div class="skeleton-bar h-4 w-full"></div>
            <div class="skeleton-bar h-4 w-[80%]"></div>
          </div>
        </div>
      </div>
    </div>

    <div class="content-layer [grid-area:1/1]">
      <div class="mt-20 lg:mt-24">
        <%= render PostHeaderComponent.new(post: @post, current_user: current_user) %>
      </div>

      <% if @post.cover_image.attached? %>
        <div class="my-6 overflow-hidden rounded-3xl">
          <%= image_tag @post.cover_image, class: "max-h-96 w-full object-cover", alt: @post.title %>
        </div>
      <% end %>

      <!-- Article Content -->
      <div data-reveal-prose data-controller="reader" class="prose max-w-none break-words">
        <%= @post.content %>
      </div>

      <% if @post.tags.any? %>
        <div class="mt-6 flex flex-wrap gap-2">
          <% @post.tags.each do |tag| %>
            <%= link_to "##{tag.name}",
                  published_posts_path(tag: tag.slug),
                  class: "rounded-full border border-gray-200 bg-white/70 px-3 py-1 text-xs font-medium text-gray-600 transition hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-900/70 dark:text-gray-300" %>
          <% end %>
        </div>
      <% end %>

      <% if @post.published? %>
        <div class="mt-6 flex flex-wrap items-center justify-between gap-4 border-t border-gray-200/70 pt-6 dark:border-gray-800">
          <div class="flex items-center gap-3">
            <%= render "reactions/button", post: @post %>
            <%= render "bookmarks/button", post: @post %>
          </div>
          <% if @post.user %>
            <%= link_to "More by #{@post.user.display_name} →",
                  author_path(@post.user),
                  class: "text-sm font-medium text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-100" %>
          <% end %>
        </div>

        <%= render "comments/section", post: @post %>
      <% end %>

      <!-- Back Link -->
      <div data-reveal-item class="mt-4 pt-4">
        <%= render ButtonComponent.new(variant: :ghost, size: :md, href: published_posts_path, icon: '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>') do %>
          Back to all stories
        <% end %>
      </div>
    </div>
  </div>
</article>
