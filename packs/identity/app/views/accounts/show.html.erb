<% content_for :title, "My account — MindCanvas" %>
<% content_for :sidebar_active, "account" %>

<%# Everything the app holds about you, on one page, read-only. Editing is one
    button away rather than inline: this is the page you open to check
    something, and a screen full of live inputs reads as work to be done.

    No container of its own — the layout owns the measure and the gutters. %>

<div data-reveal-item class="flex flex-col gap-3 pb-2 sm:flex-row sm:items-end sm:justify-between">
  <div>
    <p class="text-sm uppercase tracking-[0.2em] text-gray-500 dark:text-gray-400">My account</p>
    <h1 class="mt-1 text-2xl font-semibold text-gray-900 dark:text-gray-100">Your details</h1>
  </div>
  <%= render ButtonComponent.new(variant: :secondary, size: :md, href: edit_user_registration_path) do %>
    Edit details
  <% end %>
</div>

<%# ---- Who you are ------------------------------------------------------ %>
<section data-reveal-item class="surface-float mt-8 rounded-3xl p-6 sm:p-8">
  <div class="flex flex-col gap-5 sm:flex-row sm:items-center">
    <div class="shrink-0">
      <%= render AvatarComponent.new(name: @user.display_name, size: :xl) %>
    </div>

    <div class="min-w-0">
      <h2 class="text-2xl font-semibold tracking-tight text-gray-900 dark:text-gray-100 break-words">
        <%= @user.display_name %>
      </h2>
      <p class="mt-1 break-words text-sm text-gray-600 dark:text-gray-300"><%= @user.email %></p>
      <p class="mt-2 text-sm uppercase tracking-[0.18em] text-gray-500 dark:text-gray-400">
        Writing here since <%= @user.created_at.strftime("%B %Y") %>
      </p>
    </div>
  </div>
</section>

<%# ---- Contact ---------------------------------------------------------- %>
<%# The optional fields are shown even when empty, with the blank stated
    plainly. Hiding them would leave no sign the app ever asked, and no way to
    tell "you didn't fill this in" apart from "we don't collect this". %>
<section class="mt-10">
  <div data-reveal-item>
    <p class="text-sm uppercase tracking-[0.2em] text-gray-500 dark:text-gray-400">Contact</p>
    <h2 class="mt-1 text-lg font-semibold text-gray-900 dark:text-gray-100">How to reach you</h2>
  </div>

  <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
    <div data-reveal-item data-reveal-top class="surface-float rounded-2xl p-5">
      <p class="text-sm text-gray-500 dark:text-gray-400">Mobile number</p>
      <% if @user.mobile_number.present? %>
        <p class="mt-2 break-words text-lg font-medium text-gray-900 dark:text-gray-100"><%= @user.mobile_number %></p>
      <% else %>
        <p class="mt-2 text-lg text-gray-400 dark:text-gray-500">Not added yet</p>
      <% end %>
    </div>

    <div data-reveal-item data-reveal-top class="surface-float rounded-2xl p-5">
      <p class="text-sm text-gray-500 dark:text-gray-400">Address</p>
      <% if @user.address.present? %>
        <p class="mt-2 whitespace-pre-line break-words text-lg font-medium text-gray-900 dark:text-gray-100"><%= @user.address %></p>
      <% else %>
        <p class="mt-2 text-lg text-gray-400 dark:text-gray-500">Not added yet</p>
      <% end %>
    </div>
  </div>
</section>

<%# ---- Interests -------------------------------------------------------- %>
<section data-reveal-item class="surface-float mt-10 rounded-3xl p-6 sm:p-8">
  <p class="text-sm uppercase tracking-[0.2em] text-gray-500 dark:text-gray-400">Interests</p>
  <h2 class="mt-1 text-lg font-semibold text-gray-900 dark:text-gray-100">What you're into</h2>

  <% if @user.interests.any? %>
    <%# Chips rather than a sentence: the column underneath is a real array, so
        showing it as a list keeps the display honest about the shape. %>
    <div class="mt-5 flex flex-wrap gap-2">
      <% @user.interests.each do |interest| %>
        <span class="surface-chip inline-flex items-center rounded-full px-3.5 py-1.5 text-sm text-gray-700 dark:text-gray-200">
          <%= interest %>
        </span>
      <% end %>
    </div>
  <% else %>
    <p class="mt-3 text-sm text-gray-500 dark:text-gray-400">
      Nothing listed yet — <%= link_to "add a few", edit_user_registration_path, class: "font-medium text-gray-900 underline dark:text-gray-100" %> and they'll show up here.
    </p>
  <% end %>
</section>

<%# ---- Your writing ------------------------------------------------------ %>
<section class="mt-10">
  <div data-reveal-item>
    <p class="text-sm uppercase tracking-[0.2em] text-gray-500 dark:text-gray-400">Your writing</p>
    <h2 class="mt-1 text-lg font-semibold text-gray-900 dark:text-gray-100">What you've written</h2>
  </div>

  <div class="mt-6 grid grid-cols-2 gap-4">
    <%= link_to mine_posts_path, class: "surface-float surface-lift rounded-2xl p-5 transition-[transform,box-shadow] duration-500 ease-soft hover:-translate-y-1", data: { reveal_item: "", reveal_top: "" } do %>
      <p class="text-sm text-gray-500 dark:text-gray-400">Published</p>
      <p class="mt-2 text-3xl font-semibold tabular-nums text-gray-900 dark:text-gray-100"><%= @published_count %></p>
    <% end %>

    <%= link_to mine_posts_path(tab: "drafts"), class: "surface-float surface-lift rounded-2xl p-5 transition-[transform,box-shadow] duration-500 ease-soft hover:-translate-y-1", data: { reveal_item: "", reveal_top: "" } do %>
      <p class="text-sm text-gray-500 dark:text-gray-400">Drafts</p>
      <p class="mt-2 text-3xl font-semibold tabular-nums text-gray-900 dark:text-gray-100"><%= @draft_count %></p>
    <% end %>
  </div>
</section>
